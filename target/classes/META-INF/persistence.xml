<persistence version="2.2" xmlns="http://xmlns.jcp.org/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd">
  <persistence-unit name="com.productos_mavenproject1_jar_1.0-SNAPSHOTPU" transaction-type="RESOURCE_LOCAL">
    <!-- Agrega esta línea del proveedor de Hibernate -->
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <!-- Aquí irán tus clases y propiedades de conexión (driver, url, user, password) -->
    <class>com.productos.entities.Producto</class>
    <properties>
      <property name="" />
        <!-- URL de la base de datos, conconfigurando la base y el comportamiento con fechas -->
      <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://127.0.0.1:5432/postgres"/>
      <!-- Usuario, contraseña y driver para la conexión a la base datos -->
      <property name="jakarta.persistence.jdbc.user" value="postgres"/>
      <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
      <property name="jakarta.persistence.jdbc.password" value="1234"/>
       
      
      <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
      <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
      <!-- Mostrar las secuencias SQL -->
      <property name="hibernate.show_sql" value="false"/>
      <!-- Formatear las secuencias SQL -->
      <property name="hibernate.format_sql" value="true"/>
      <!-- Habilitar las secuencias "SQL logging" para ver consultas en los logs -->
      <property name="hibernate.use_sql_comments" value="true"/>
      <!-- Habilitar la actualización automática de esquema si es necesario-->
      <property name="hibernate.hbdm2ddl.auto" value="update"/>
      <!-- Reemplazar el dialecto en caso de que no se seleccione automáticamente -->
     <!-- <property name="hibernate.dialect" value="org.hibernate.dialect.Hy5QL80ialect"/> -->
    </properties>
  </persistence-unit>
</persistence>
